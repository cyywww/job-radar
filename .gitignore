# Dependencies and generated artifacts
node_modules/
.pnpm-store/
dist/
coverage/
*.tsbuildinfo
*.log
*.pid

# Local environment and secrets
.env
.env.*
!.env.example

# Local runtime state
/data/*
!/data/.gitkeep
/logs/*
!/logs/.gitkeep
/config/*
!/config/.gitkeep
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-journal
*.db-shm
*.db-wal

# Local imports, backups, and test reports
/uploads/
/imports/
/backups/
/tmp/
/test-results/
/playwright-report/
/blob-report/
.playwright/
.nyc_output/
*.lcov
.vitest/
.cache/

# Personal material must never enter source control
private/
profiles/
resumes/
applications/
/[Rr]esume.*
/[Cc][Vv].*

# Editors and macOS
.DS_Store
.idea/
.vscode/

# Tool caches
.vite/
.eslintcache
