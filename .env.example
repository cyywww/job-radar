# Server binding. Keep the default loopback address for local-only access.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Relative paths are resolved from the repository root. Absolute paths work too.
JOB_RADAR_DATA_DIR=./data
JOB_RADAR_CONFIG_DIR=./config
JOB_RADAR_LOG_DIR=./logs
JOB_RADAR_DATABASE_PATH=./data/job-radar.sqlite
JOB_RADAR_WEB_DIST_DIR=./apps/web/dist

# M3 scoring. The app starts without AI, but queue processing requires an explicit model.
JOB_RADAR_CODEX_BINARY=codex
# JOB_RADAR_CODEX_MODEL=your-approved-codex-model
JOB_RADAR_SCORING_TIMEOUT_MS=120000
JOB_RADAR_SCORING_MAX_OUTPUT_BYTES=262144
JOB_RADAR_SCORING_MAX_ATTEMPTS=3
JOB_RADAR_SCORING_RETRY_BASE_MS=60000
JOB_RADAR_SCORING_RETRY_MAX_MS=3600000
JOB_RADAR_SCORING_REVIEW_CONFIDENCE=0.65
