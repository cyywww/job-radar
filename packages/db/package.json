{
  "name": "@job-radar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@job-radar/config": "workspace:*",
    "@job-radar/scoring": "workspace:*",
    "@job-radar/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@job-radar/testing": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12"
  }
}
